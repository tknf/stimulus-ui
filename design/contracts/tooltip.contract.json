{
  "name": "tooltip",
  "controller": "tooltip",
  "pattern": "A hover/focus tooltip using authored triggers and the WAI-ARIA tooltip role",
  "responsibility": "Provide trigger/content relationships, visibility state, and hover/focus/Escape behavior without generating elements, wording, or positioning.",
  "references": [
    "https://www.w3.org/WAI/ARIA/apg/patterns/tooltip/",
    "https://www.w3.org/WAI/WCAG22/Understanding/content-on-hover-or-focus.html",
    "https://html.spec.whatwg.org/multipage/popover.html",
    "https://www.w3.org/TR/WCAG22/"
  ],
  "authorMarkup": {
    "root": "An existing HTMLElement with data-controller=\"tooltip\"",
    "trigger": "A native button/link or focusable HTMLElement inside the root with data-tooltip-target=\"trigger\", named by the consumer",
    "content": "An existing HTMLElement inside the root with data-tooltip-target=\"content\", with consumer-authored wording",
    "position": "Consumer CSS determines position, offset, z-index, and transitions.",
    "contentRules": "Content must not contain focusable descendants. Use dialog for interactive supplemental information."
  },
  "contractValidation": {
    "targets": [
      "Exactly one trigger descending from the root",
      "Exactly one content target descending from the root",
      "Content and trigger are distinct elements.",
      "Content has no focusable descendants.",
      "The Popover API is available."
    ],
    "invalidMarkup": "Invalid markup emits one warning per connection and disables ARIA, listeners, timers, state, and visibility operations. Do not throw.",
    "completion": {
      "attributes": ["role=\"tooltip\" on content", "popover=\"manual\" on content"],
      "warning": "The completion warning lists the added attributes: \"Added <attributes>. Include them in your markup.\" It is emitted once while connected, using a separate flag from the enhancement-disabled warning"
    },
    "warning": "The warning identifies tooltip controller, expected markup, and the violated condition."
  },
  "api": {
    "values": {
      "delay": {
        "type": "Number",
        "htmlAttribute": "data-tooltip-delay-value",
        "default": 0,
        "description": "Nonnegative delay in milliseconds before opening from hover or focus"
      }
    },
    "properties": {
      "open": {
        "type": "boolean",
        "access": "getter/setter",
        "description": "Current visibility. Assignment emits no events."
      }
    },
    "methods": {
      "show()": {
        "returns": "void",
        "description": "Show programmatically without custom events."
      },
      "hide()": {
        "returns": "void",
        "description": "Hide programmatically without custom events."
      }
    },
    "events": {
      "tooltip:beforetoggle": {
        "bubbles": true,
        "cancelable": true,
        "detail": {
          "open": "boolean",
          "previousOpen": "boolean",
          "reason": "pointer | keyboard"
        }
      },
      "tooltip:toggle": {
        "bubbles": true,
        "cancelable": false,
        "detail": {
          "open": "boolean",
          "previousOpen": "boolean",
          "reason": "pointer | keyboard"
        }
      },
      "programmatic": "The open setter, show/hide, initialization, reconnection, external popover toggles, and disconnect emit no custom events."
    }
  },
  "managedMarkup": {
    "role": "Supply role=\"tooltip\" only when content has no role.",
    "describedby": "Append the content id to trigger aria-describedby, preserving existing tokens and ids.",
    "id": "Generate a missing content id without collisions in ownerDocument.",
    "popover": "Supply missing popover=\"manual\" and use Popover API visibility state.",
    "stateOnly": "Output data-state=\"open\" or \"closed\" on root/content, without classes."
  },
  "behavior": {
    "hover": "Stay open as the pointer moves from trigger to content and while hovering content.",
    "focus": "Stay open while the trigger has focus. The controller does not move focus.",
    "dismiss": "Escape closes the tooltip. After Escape, hover alone cannot reopen it until the pointer leaves the trigger.",
    "persistent": "There is no automatic close timer limiting visibility duration.",
    "delay": "Apply delay only to opening. Cancel pending opening when pointer/focus leaves."
  },
  "keyboard": {
    "Escape": "Close an open tooltip and prevent the default action.",
    "focusModel": "Keep DOM focus on the trigger; tooltip content does not receive focus."
  },
  "lifecycle": [
    "Register trigger/content/document listeners in connect() and remove them in disconnect().",
    "Do not duplicate listeners/timers on Turbo reconnection.",
    "Reconcile target/value changes."
  ],
  "manualVerification": {
    "blocking": [],
    "observations": [
      {
        "environment": "VoiceOver, JAWS, and Narrator on real devices",
        "item": "Differences in aria-describedby announcements",
        "status": "unverified",
        "impact": "The tooltip description relationship and dismissal behavior are fixed; compatibility wording does not select a new API."
      }
    ]
  },
  "acceptanceCriteria": [
    "Required AAA criteria: 2.1.3 Keyboard (No Exception), with no pointer-only features; and 3.2.5 Change on Request, with controller focus movement limited to user actions or consumer JS calls, never timers.",
    "Meet WCAG 2.2 Level AA, especially 1.4.13 Dismissible, Hoverable, and Persistent.",
    "Synchronize the tooltip role and aria-describedby relationship.",
    "Pass automated tests in Chromium, Firefox, and WebKit.",
    "Report real-device differences in aria-describedby announcements among VoiceOver, JAWS, and Narrator as unverified."
  ],
  "testMatrix": [
    {
      "testId": "tooltip-state-sync",
      "description": "Synchronize role, id, aria-describedby, popover, and data-state"
    },
    {
      "testId": "tooltip-focus-escape",
      "description": "Focus opening, Escape dismissal, keyboard reason, and cancellation"
    },
    {
      "testId": "tooltip-hoverable-delay",
      "description": "pointer hover、content hover、delay、pointer reason"
    },
    {
      "testId": "tooltip-programmatic-silence",
      "description": "Event suppression for open/show/hide"
    },
    {
      "testId": "tooltip-lifecycle",
      "description": "Dynamic targets, disconnect/reconnect, and listener cleanup"
    },
    {
      "testId": "tooltip-semantic-validation",
      "description": "Warnings and disabled enhancement for focusable content"
    },
    {
      "testId": "tooltip-event-trust",
      "description": "Synthetic-event suppression in each pointer/focus/keydown handler"
    },
    {
      "testId": "tooltip-hover-transitions",
      "description": "Trigger/content pointer transitions and pending-timer cleanup"
    },
    {
      "testId": "tooltip-external-toggle",
      "description": "State synchronization from external popover toggles"
    },
    {
      "testId": "tooltip-schedule-noop",
      "description": "No reopening timer while already open"
    },
    {
      "testId": "tooltip-popover-failure",
      "description": "No state/event commitment when the Popover API fails"
    },
    {
      "testId": "tooltip-disconnect-cleanup",
      "description": "Listener, timer, and connection-state cleanup on disconnect"
    },
    {
      "testId": "tooltip-markup-guards",
      "description": "Target count, trigger, Popover API, delay, and disabled/hidden content validation"
    },
    {
      "testId": "tooltip-structure-preservation",
      "description": "Preservation of authored role and popover"
    },
    {
      "testId": "tooltip-warning-once",
      "description": "One invalid-markup warning per connection"
    },
    {
      "testId": "tooltip-completion-warning",
      "description": "Completion warning for missing attributes, no warning for complete markup, and separation from the invalid-markup warning"
    }
  ],
