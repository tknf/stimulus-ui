{
  "name": "@tknf/stimulus-ui",
  "version": "0.1.0",
  "description": "Headless, accessible Stimulus controllers for your HTML",
  "keywords": [
    "accessibility",
    "headless",
    "hotwire",
    "stimulus",
    "ui"
  ],
  "homepage": "https://github.com/tknf/stimulus-ui#readme",
  "bugs": {
    "url": "https://github.com/tknf/stimulus-ui/issues"
  },
  "license": "MIT",
  "author": "TKNF",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tknf/stimulus-ui.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "browsers:install": "playwright install chromium firefox webkit",
    "check": "vp check",
    "check:api-docs": "node scripts/check_api_docs.mjs",
    "check:workflow-safety": "node scripts/check_workflow_safety.mjs",
    "check:contracts": "node scripts/check_contracts.mjs",
    "check:package": "node scripts/check_package.mjs",
    "check:release-readiness": "node scripts/check_release_readiness.mjs",
    "check:test-reporting": "node scripts/check_test_reporting.mjs",
    "check:negative-controls": "node scripts/check_negative_controls.mjs",
    "build": "vp pack",
    "prepare": "vp config",
    "prepublishOnly": "vp run build",
    "test": "vp test",
    "test:api-docs": "node --test scripts/check_api_docs.test.mjs",
    "test:release-readiness": "node --test scripts/check_release_readiness.test.mjs",
    "test:chromium": "vp test run --browser.name chromium",
    "test:log": "mkdir -p test-results && vp test run --project \"${TEST_BROWSER:-*}\" > test-results/console.log 2>&1 || (tail -60 test-results/console.log; exit 1)"
  },
  "devDependencies": {
    "@hotwired/stimulus": "3.2.2",
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.2.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}
